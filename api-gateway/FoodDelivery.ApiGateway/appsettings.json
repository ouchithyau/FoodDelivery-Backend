{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "ordering-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "logistics-route": {
        "ClusterId": "logistics-cluster",
        "Match": {
          "Path": "/api/logistics/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "ordering-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7113"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7098"
          }
        }
      },
      "logistics-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5078"
          }
        }
      }
    }
  }
}